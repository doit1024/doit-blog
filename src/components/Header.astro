---
import Hr from "./Hr.astro";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import LinkButton from "./LinkButton.astro";
import { SITE } from "@/config";

const { pathname } = Astro.url;

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};

const mainLinks = [
  { href: "/posts", label: "文章" },
  { href: "/bb", label: "哔哔" },
  { href: "/library", label: "库" },
  { href: "/about", label: "关于" },
];

const moreLinks = [
  { href: "/tags", label: "标签" },
  { href: "/changelog", label: "日志" },
  ...(SITE.showArchives ? [{ href: "/archives", label: "归档" }] : []),
];

const mobileLinks = [...mainLinks, ...moreLinks];

const isMoreActive = moreLinks.some(link => isActive(link.href));
---

<header class="relative z-[60]">
  <!-- <a
    id="skip-to-content"
    href="#main-content"
    class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
  >
    Skip to content
  </a> -->
  <div
    id="nav-container"
    class="mx-auto flex max-w-app flex-col items-center justify-between sm:flex-row"
  >
    <div
      id="top-nav-wrap"
      class="relative w-full bg-background sm:flex sm:items-center sm:justify-between sm:p-4 sm:py-6"
    >
      <a
        href="/"
        data-astro-prefetch="load"
        class="header-title py-1 text-xl leading-8 font-semibold whitespace-nowrap transition-colors hover:text-accent sm:my-auto sm:text-2xl sm:leading-none"
      >
        🧠 {SITE.title}
      </a>
      <nav
        id="nav-menu"
        class="hidden sm:ms-2 sm:flex sm:flex-1 sm:flex-row sm:items-center sm:justify-end sm:space-x-4 sm:py-0"
      >
        <ul
          id="menu-items"
          class:list={[
            "[&>li>a]:block [&>li>a]:px-4 [&>li>a]:py-3 [&>li>a]:text-center [&>li>a]:font-medium [&>li>a]:hover:text-accent sm:[&>li>a]:px-2 sm:[&>li>a]:py-1",
            "sm:mt-0 sm:flex sm:w-auto sm:gap-x-5 sm:gap-y-0",
          ]}
        >
          {
            mainLinks.map(link => (
              <li>
                <a
                  href={link.href}
                  data-astro-prefetch="load"
                  class:list={{ "active-nav": isActive(link.href) }}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          <li id="more-nav" class="relative">
            <button
              id="more-btn"
              type="button"
              class="inline-flex w-full items-center justify-center gap-0.5 px-4 py-3 text-center font-medium hover:text-accent sm:w-auto sm:px-2 sm:py-1"
              aria-expanded="false"
              aria-controls="more-menu"
            >
              <span class:list={[{ "active-nav": isMoreActive }]}>更多</span>
              <span
                class="more-chevron inline-flex rotate-90 transition-transform"
                aria-hidden="true"
              >
                <IconChevronRight class="size-3.5 shrink-0" />
              </span>
            </button>
            <ul
              id="more-menu"
              class="z-[70] mt-1 hidden rounded-md border border-border bg-background py-1 sm:absolute sm:end-0 sm:top-full sm:mt-2 sm:w-max sm:min-w-20 sm:shadow-sm"
              hidden
            >
              {
                moreLinks.map(link => (
                  <li>
                    <a
                      href={link.href}
                      data-astro-prefetch="load"
                      class:list={[
                        "block px-4 py-2 text-center font-medium whitespace-nowrap hover:text-accent sm:px-3",
                        { "active-nav": isActive(link.href) },
                      ]}
                      aria-current={isActive(link.href) ? "page" : undefined}
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </li>
        </ul>
      </nav>
      <div class="mobile-icons sm:ms-5 sm:flex sm:items-center sm:gap-5">
        <LinkButton
          href="/search"
          prefetch="load"
          class:list={[
            "focus-outline flex size-10 items-center justify-center p-0 sm:size-auto sm:px-2 sm:py-1",
            { "[&>svg]:stroke-accent": isActive("/search") },
          ]}
          ariaLabel="search"
          title="Search"
        >
          <IconSearch />
          <span class="sr-only">Search</span>
        </LinkButton>
        {
          SITE.lightAndDarkMode && (
            <button
              id="theme-btn"
              class="focus-outline relative size-10 p-4 sm:size-8 hover:[&>svg]:stroke-accent"
              title="Toggles light & dark"
              aria-label="auto"
              aria-live="polite"
            >
              <IconMoon class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
              <IconSunHigh class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
            </button>
          )
        }
      </div>
      <nav class="mobile-nav sm:hidden" aria-label="主导航">
        <ul>
          {
            mobileLinks.map(link => (
              <li>
                <a
                  href={link.href}
                  data-astro-prefetch="load"
                  aria-current={isActive(link.href) ? "page" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
  <Hr />
</header>

<style>
  #more-btn[aria-expanded="true"] .more-chevron {
    rotate: 270deg;
  }

  /* Option B chip grid. Below Tailwind `sm` (40rem) only — desktop stays a single row. */
  @media (width < 40rem) {
    #top-nav-wrap {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "title tools"
        "chips chips";
      align-items: center;
      padding: 16px 16px 0;
    }

    .header-title {
      grid-area: title;
    }

    .mobile-icons {
      grid-area: tools;
      display: flex;
      align-items: center;
      gap: 2px;
      margin-inline-end: -6px;
    }

    /* LinkButton's `inline-block` wins over `flex`, so center the glyph here. */
    .mobile-icons :global(a) {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .mobile-nav {
      grid-area: chips;
      padding: 8px 0 12px;
    }

    .mobile-nav ul {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 6px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .mobile-nav a {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 30px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 500;
      line-height: 1;
      white-space: nowrap;
      color: var(--foreground);
      background: color-mix(in srgb, var(--muted) 22%, transparent);
      transition:
        color 0.15s,
        background-color 0.15s;
    }

    .mobile-nav a:hover {
      color: var(--accent);
    }

    .mobile-nav a[aria-current="page"] {
      font-weight: 600;
      color: var(--accent);
      background: color-mix(in srgb, var(--accent) 12%, transparent);
      box-shadow: inset 0 0 0 1px
        color-mix(in srgb, var(--accent) 45%, transparent);
    }
  }
</style>

<script>
  function queryButton(selector: string) {
    const el = document.querySelector(selector);
    return el instanceof HTMLButtonElement ? el : null;
  }

  function closeMoreMenu(restoreFocus = false) {
    const moreBtn = queryButton("#more-btn");
    const moreMenu = document.querySelector("#more-menu");
    if (!moreBtn || !moreMenu) return;

    const wasOpen = moreBtn.getAttribute("aria-expanded") === "true";
    moreBtn.setAttribute("aria-expanded", "false");
    moreMenu.classList.add("hidden");
    moreMenu.setAttribute("hidden", "");
    if (restoreFocus && wasOpen) moreBtn.focus();
  }

  function openMoreMenu() {
    const moreBtn = queryButton("#more-btn");
    const moreMenu = document.querySelector("#more-menu");
    if (!moreBtn || !moreMenu) return;

    moreBtn.setAttribute("aria-expanded", "true");
    moreMenu.classList.remove("hidden");
    moreMenu.removeAttribute("hidden");
  }

  function bindMoreMenu() {
    const moreNav = document.querySelector("#more-nav");
    const moreBtn = queryButton("#more-btn");
    const moreMenu = document.querySelector("#more-menu");
    if (!moreNav || !moreBtn || !moreMenu) return;
    if (moreBtn.dataset.bound === "true") return;
    moreBtn.dataset.bound = "true";

    const items = () =>
      [...moreMenu.querySelectorAll("a")].filter(
        (link): link is HTMLAnchorElement => link instanceof HTMLAnchorElement
      );

    moreBtn.addEventListener("click", () => {
      const open = moreBtn.getAttribute("aria-expanded") === "true";
      if (open) closeMoreMenu();
      else openMoreMenu();
    });

    moreNav.addEventListener("keydown", event => {
      if (!(event instanceof KeyboardEvent)) return;
      const links = items();
      const open = moreBtn.getAttribute("aria-expanded") === "true";

      if (event.key === "ArrowDown" || event.key === "ArrowUp") {
        if (!links.length) return;
        event.preventDefault();
        if (!open) {
          openMoreMenu();
          const target =
            event.key === "ArrowDown" ? links[0] : links[links.length - 1];
          target.focus();
          return;
        }

        const active = document.activeElement;
        const index =
          active instanceof HTMLAnchorElement ? links.indexOf(active) : -1;
        if (event.key === "ArrowDown") {
          links[(index + 1) % links.length]?.focus();
          return;
        }
        if (index <= 0) moreBtn.focus();
        else links[index - 1]?.focus();
      }
    });

    moreNav.addEventListener("focusout", () => {
      requestAnimationFrame(() => {
        const active = document.activeElement;
        if (active instanceof Node && moreNav.contains(active)) return;
        closeMoreMenu();
      });
    });
  }

  function bindHeaderDismiss() {
    if (document.documentElement.dataset.moreMenuBound === "true") return;
    document.documentElement.dataset.moreMenuBound = "true";

    document.addEventListener("click", event => {
      const moreNav = document.querySelector("#more-nav");
      if (!moreNav || !(event.target instanceof Node)) return;
      if (moreNav.contains(event.target)) return;
      closeMoreMenu();
    });

    document.addEventListener("keydown", event => {
      if (event.key !== "Escape") return;
      closeMoreMenu(true);
    });
  }

  function initHeader() {
    bindMoreMenu();
    bindHeaderDismiss();
  }

  initHeader();

  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", initHeader);
</script>
