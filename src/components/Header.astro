---
import Hr from "./Hr.astro";
import IconX from "@/assets/icons/IconX.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconChevronRight from "@/assets/icons/IconChevronRight.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import LinkButton from "./LinkButton.astro";
import { SITE } from "@/config";

const { pathname } = Astro.url;

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};

const moreLinks = [
  { href: "/tags", label: "标签" },
  { href: "/changelog", label: "日志" },
  ...(SITE.showArchives ? [{ href: "/archives", label: "归档" }] : []),
];

const isMoreActive = moreLinks.some(link => isActive(link.href));
---

<header class="relative z-[60]">
  <!-- <a
    id="skip-to-content"
    href="#main-content"
    class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
  >
    Skip to content
  </a> -->
  <div
    id="nav-container"
    class="mx-auto flex max-w-app flex-col items-center justify-between sm:flex-row"
  >
    <div
      id="top-nav-wrap"
      class="relative flex w-full items-baseline justify-between bg-background p-4 sm:items-center sm:py-6"
    >
      <a
        href="/"
        data-astro-prefetch="load"
        class="absolute py-1 text-xl leading-8 font-semibold whitespace-nowrap transition-colors hover:text-accent sm:static sm:my-auto sm:text-2xl sm:leading-none"
      >
        🧠 {SITE.title}
      </a>
      <nav
        id="nav-menu"
        class="flex w-full flex-col items-center sm:ms-2 sm:flex-row sm:justify-end sm:space-x-4 sm:py-0"
      >
        <button
          id="menu-btn"
          class="focus-outline self-end p-2 sm:hidden"
          aria-label="Open Menu"
          aria-expanded="false"
          aria-controls="menu-items"
        >
          <IconX id="close-icon" class="hidden" />
          <IconMenuDeep id="menu-icon" />
        </button>
        <ul
          id="menu-items"
          class:list={[
            "mt-4 grid w-44 grid-cols-2 place-content-center gap-2",
            "[&>li>a]:block [&>li>a]:px-4 [&>li>a]:py-3 [&>li>a]:text-center [&>li>a]:font-medium [&>li>a]:hover:text-accent sm:[&>li>a]:px-2 sm:[&>li>a]:py-1",
            "hidden",
            "sm:mt-0 sm:flex sm:w-auto sm:gap-x-5 sm:gap-y-0",
          ]}
        >
          <li class="col-span-2">
            <a
              href="/posts"
              data-astro-prefetch="load"
              class:list={{ "active-nav": isActive("/posts") }}
            >
              文章
            </a>
          </li>
          <li class="col-span-2">
            <a
              href="/bb"
              data-astro-prefetch="load"
              class:list={{ "active-nav": isActive("/bb") }}
            >
              哔哔
            </a>
          </li>
          <li class="col-span-2">
            <a
              href="/library"
              data-astro-prefetch="load"
              class:list={{ "active-nav": isActive("/library") }}
            >
              库
            </a>
          </li>
          <li class="col-span-2">
            <a
              href="/about"
              data-astro-prefetch="load"
              class:list={{ "active-nav": isActive("/about") }}
            >
              关于
            </a>
          </li>
          <li id="more-nav" class="relative col-span-2">
            <button
              id="more-btn"
              type="button"
              class="inline-flex w-full items-center justify-center gap-0.5 px-4 py-3 text-center font-medium hover:text-accent sm:w-auto sm:px-2 sm:py-1"
              aria-expanded="false"
              aria-controls="more-menu"
            >
              <span class:list={[{ "active-nav": isMoreActive }]}>更多</span>
              <span
                class="more-chevron inline-flex rotate-90 transition-transform"
                aria-hidden="true"
              >
                <IconChevronRight class="size-3.5 shrink-0" />
              </span>
            </button>
            <ul
              id="more-menu"
              class="z-[70] mt-1 hidden rounded-md border border-border bg-background py-1 sm:absolute sm:end-0 sm:top-full sm:mt-2 sm:w-max sm:shadow-sm"
              hidden
            >
              {
                moreLinks.map(link => (
                  <li>
                    <a
                      href={link.href}
                      data-astro-prefetch="load"
                      class:list={[
                        "block px-4 py-2 text-center font-medium whitespace-nowrap hover:text-accent sm:px-2",
                        { "active-nav": isActive(link.href) },
                      ]}
                      aria-current={isActive(link.href) ? "page" : undefined}
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </li>
          <li class="col-span-1 flex items-center justify-center">
            <LinkButton
              href="/search"
              prefetch="load"
              class:list={[
                "focus-outline flex p-3 sm:p-1",
                { "[&>svg]:stroke-accent": isActive("/search") },
              ]}
              ariaLabel="search"
              title="Search"
            >
              <IconSearch />
              <span class="sr-only">Search</span>
            </LinkButton>
          </li>
          {
            SITE.lightAndDarkMode && (
              <li class="col-span-1 flex items-center justify-center">
                <button
                  id="theme-btn"
                  class="focus-outline relative size-12 p-4 sm:size-8 hover:[&>svg]:stroke-accent"
                  title="Toggles light & dark"
                  aria-label="auto"
                  aria-live="polite"
                >
                  <IconMoon class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                  <IconSunHigh class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
                </button>
              </li>
            )
          }
        </ul>
      </nav>
    </div>
  </div>
  <Hr />
</header>

<style>
  #more-btn[aria-expanded="true"] .more-chevron {
    rotate: 270deg;
  }
</style>

<script>
  function queryButton(selector: string) {
    const el = document.querySelector(selector);
    return el instanceof HTMLButtonElement ? el : null;
  }

  function closeMoreMenu(restoreFocus = false) {
    const moreBtn = queryButton("#more-btn");
    const moreMenu = document.querySelector("#more-menu");
    if (!moreBtn || !moreMenu) return;

    const wasOpen = moreBtn.getAttribute("aria-expanded") === "true";
    moreBtn.setAttribute("aria-expanded", "false");
    moreMenu.classList.add("hidden");
    moreMenu.setAttribute("hidden", "");
    if (restoreFocus && wasOpen) moreBtn.focus();
  }

  function openMoreMenu() {
    const moreBtn = queryButton("#more-btn");
    const moreMenu = document.querySelector("#more-menu");
    if (!moreBtn || !moreMenu) return;

    moreBtn.setAttribute("aria-expanded", "true");
    moreMenu.classList.remove("hidden");
    moreMenu.removeAttribute("hidden");
  }

  function toggleNav() {
    const menuBtn = queryButton("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;
    if (menuBtn.dataset.bound === "true") return;
    menuBtn.dataset.bound = "true";

    menuBtn.addEventListener("click", () => {
      const openMenu = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", openMenu ? "false" : "true");
      menuBtn.setAttribute("aria-label", openMenu ? "Open Menu" : "Close Menu");

      menuItems.classList.toggle("hidden");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
      if (openMenu) closeMoreMenu();
    });
  }

  function bindMoreMenu() {
    const moreNav = document.querySelector("#more-nav");
    const moreBtn = queryButton("#more-btn");
    const moreMenu = document.querySelector("#more-menu");
    if (!moreNav || !moreBtn || !moreMenu) return;
    if (moreBtn.dataset.bound === "true") return;
    moreBtn.dataset.bound = "true";

    const items = () =>
      [...moreMenu.querySelectorAll("a")].filter(
        (link): link is HTMLAnchorElement => link instanceof HTMLAnchorElement
      );

    moreBtn.addEventListener("click", () => {
      const open = moreBtn.getAttribute("aria-expanded") === "true";
      if (open) closeMoreMenu();
      else openMoreMenu();
    });

    moreNav.addEventListener("keydown", event => {
      if (!(event instanceof KeyboardEvent)) return;
      const links = items();
      const open = moreBtn.getAttribute("aria-expanded") === "true";

      if (event.key === "ArrowDown" || event.key === "ArrowUp") {
        if (!links.length) return;
        event.preventDefault();
        if (!open) {
          openMoreMenu();
          const target =
            event.key === "ArrowDown" ? links[0] : links[links.length - 1];
          target.focus();
          return;
        }

        const active = document.activeElement;
        const index =
          active instanceof HTMLAnchorElement ? links.indexOf(active) : -1;
        if (event.key === "ArrowDown") {
          links[(index + 1) % links.length]?.focus();
          return;
        }
        if (index <= 0) moreBtn.focus();
        else links[index - 1]?.focus();
      }
    });

    moreNav.addEventListener("focusout", () => {
      requestAnimationFrame(() => {
        const active = document.activeElement;
        if (active instanceof Node && moreNav.contains(active)) return;
        closeMoreMenu();
      });
    });
  }

  function bindHeaderDismiss() {
    if (document.documentElement.dataset.moreMenuBound === "true") return;
    document.documentElement.dataset.moreMenuBound = "true";

    document.addEventListener("click", event => {
      const moreNav = document.querySelector("#more-nav");
      if (!moreNav || !(event.target instanceof Node)) return;
      if (moreNav.contains(event.target)) return;
      closeMoreMenu();
    });

    document.addEventListener("keydown", event => {
      if (event.key !== "Escape") return;
      closeMoreMenu(true);
    });
  }

  function initHeader() {
    toggleNav();
    bindMoreMenu();
    bindHeaderDismiss();
  }

  initHeader();

  // Runs on view transitions navigation
  document.addEventListener("astro:after-swap", initHeader);
</script>
