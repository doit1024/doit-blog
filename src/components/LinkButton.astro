---
export interface Props {
  id?: string;
  href: string;
  class?: string;
  ariaLabel?: string;
  title?: string;
  disabled?: boolean;
  redirect?: boolean;
  prefetch?: "hover" | "tap" | "viewport" | "load" | boolean;
}

const {
  id,
  href,
  class: className = "",
  ariaLabel,
  title,
  disabled = false,
  redirect = true,
  prefetch,
} = Astro.props;

const prefetchValue =
  prefetch === undefined
    ? undefined
    : prefetch === true
      ? ""
      : String(prefetch);
---

{
  disabled ? (
    <span
      id={id}
      class:list={["group inline-block", className]}
      title={title}
      aria-disabled={disabled}
    >
      <slot />
    </span>
  ) : (
    <a
      id={id}
      {href}
      target={redirect ? "_self" : "_blank"}
      class:list={["group inline-block hover:text-accent", className]}
      aria-label={ariaLabel}
      title={title}
      data-astro-prefetch={prefetchValue}
    >
      <slot />
    </a>
  )
}
