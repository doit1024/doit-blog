---
import {
  LIBRARY_COVER_SIZES,
  LIBRARY_COVER_THUMB_MAX_WIDTH,
  libraryCoverBox,
  libraryThumbCover,
} from "@/components/library/covers";
import {
  canonicalMediaType,
  metaLine,
  type MediaItem,
} from "@/utils/media-library/types";

interface Props {
  item: MediaItem;
  /** First row of the initial paint. The rest stay lazy. */
  eager?: boolean;
  fetchPriority?: "high" | "low" | "auto";
}

const { item, eager = false, fetchPriority } = Astro.props;
const type = canonicalMediaType(item.type);
const meta = metaLine(type, item.year);
const square = type === "音乐";
const thumb = item.cover ? libraryThumbCover(item.cover) : null;
const thumbBox = libraryCoverBox(
  LIBRARY_COVER_THUMB_MAX_WIDTH,
  square ? "square" : "poster"
);
---

<li data-media-card data-type={type ?? ""}>
  <button
    type="button"
    class="library-card"
    data-library-open
    data-media-id={item.id}
    data-title={item.title}
    data-type={type ?? ""}
    data-meta={meta}
    data-cover={item.cover ?? ""}
    data-url={item.url ?? ""}
    data-note={item.note ?? ""}
    data-rating={item.rating == null ? "" : String(item.rating)}
    data-created={item.created ?? ""}
    data-hours={item.playHours == null ? "" : String(item.playHours)}
    data-artist={item.artist ?? ""}
  >
    <div class:list={["poster", { "is-square": square }]} data-poster>
      {
        thumb && (
          <img
            src={thumb}
            alt=""
            width={thumbBox.width}
            height={thumbBox.height}
            sizes={LIBRARY_COVER_SIZES}
            loading={eager ? "eager" : "lazy"}
            decoding="async"
            fetchpriority={fetchPriority}
            referrerpolicy="no-referrer"
          />
        )
      }
      <p class="fallback" aria-hidden="true">
        <span>{item.title}</span>
      </p>
    </div>
    <p class="library-name">{item.title}</p>
    {meta && <p class="library-meta">{meta}</p>}
    <span class="library-card-action">查看详情</span>
  </button>
</li>
