---
import { metaLine, type MediaItem } from "@/utils/media-library/types";

interface Props {
  item: MediaItem;
}

const { item } = Astro.props;
const meta = metaLine(item.type, item.year);
---

<li data-media-card data-type={item.type ?? ""}>
  <button
    type="button"
    class="library-card"
    data-library-open
    data-media-id={item.id}
    data-title={item.title}
    data-meta={meta}
    data-cover={item.cover ?? ""}
    data-url={item.url ?? ""}
    data-note={item.note ?? ""}
    data-rating={item.rating == null ? "" : String(item.rating)}
    data-created={item.created ?? ""}
  >
    <div class="poster" data-poster>
      {
        item.cover && (
          <img
            src={item.cover}
            alt=""
            loading="lazy"
            decoding="async"
            referrerpolicy="no-referrer"
          />
        )
      }
      <p class="fallback" aria-hidden="true">
        <span>{item.title}</span>
      </p>
    </div>
    <p class="library-name">{item.title}</p>
    {meta && <p class="library-meta">{meta}</p>}
    <span class="library-card-action">查看详情</span>
  </button>
</li>
