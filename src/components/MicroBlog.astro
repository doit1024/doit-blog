---
import { NotionRenderer } from "react-notion-x";
import type { ExtendedRecordMap } from "notion-types";
import dayjs from "dayjs";

export interface Props {
  blockData: ExtendedRecordMap;
}

const { blockData } = Astro.props;

const pageBlock = blockData?.block
  ? Object.values(blockData.block).find(
      block => block?.value?.type === "page"
    )
  : undefined;

const createdTime = pageBlock?.value?.created_time;
const tagString = pageBlock?.value?.properties?.rRiX?.[0]?.[0] ?? "";
const tags = tagString
  ? tagString.split(",").map(tag => tag.trim()).filter(Boolean)
  : [];
const canRender = Boolean(blockData?.block && pageBlock);
---

<div class="rounded-lg border border-border p-6">
  {
    canRender ? (
      <NotionRenderer
        client:only="react"
        recordMap={blockData}
        fullPage={false}
        darkMode={false}
      />
    ) : (
      <p class="text-muted-foreground">这条内容暂时无法显示。</p>
    )
  }
  <div
    class="mt-4 flex items-center justify-between text-sm text-foreground/60"
  >
    <div class="flex gap-1">
      {tags.map((tag: string) => <span>#{tag}</span>)}
    </div>
    {
      createdTime ? (
        <time datetime={dayjs(createdTime).toISOString()} class="block">
          {dayjs(createdTime).format("YYYY-MM-DD HH:mm:ss")}
        </time>
      ) : null
    }
  </div>
</div>
