---
import { Image } from "astro:assets";
import getFeaturedWorks from "@/utils/getFeaturedWorks";

const works = await getFeaturedWorks();
---

{
  works.length > 0 && (
    <section id="works" class="pt-12 pb-6" aria-labelledby="works-heading">
      <h2 id="works-heading" class="text-2xl font-semibold tracking-wide">
        在做的
      </h2>
      <ul>
        {works.map(work => {
          const { name, description, href, image, imageAlt, external } =
            work.data;
          return (
            <li class="my-6">
              <a
                href={href}
                class="group flex items-start gap-4"
                target={external ? "_blank" : undefined}
                rel={external ? "noopener noreferrer" : undefined}
              >
                <div class="work-thumb">
                  <Image
                    src={image}
                    alt={imageAlt}
                    width={288}
                    height={180}
                    class="h-full w-full object-cover"
                    draggable="false"
                  />
                </div>
                <div class="min-w-0">
                  <h3 class="text-lg font-medium text-accent decoration-dashed underline-offset-4 group-hover:underline">
                    {name}
                  </h3>
                  <p class="mt-1">{description}</p>
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </section>
  )
}

<style>
  .work-thumb {
    flex: none;
    width: 6.75rem;
    height: 4.25rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--muted);
  }

  @media (min-width: 640px) {
    .work-thumb {
      width: 8.5rem;
      height: 5.25rem;
    }
  }
</style>
