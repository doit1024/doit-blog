---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import CollageDrag from "./CollageDrag";
import CollageSticker from "./CollageSticker.astro";
import { SOCIALS } from "@/constants";

import cloudBanner from "@/assets/collage/paper/paper-cloud-banner.png";
import postageStamp from "@/assets/collage/paper/paper-postage-stamp.png";
import spiralNotebook from "@/assets/collage/paper/paper-spiral-notebook.png";
import tornLong from "@/assets/collage/paper/paper-torn-strip-long.png";
import tornMed from "@/assets/collage/paper/paper-torn-strip-med.png";
import tornSmall from "@/assets/collage/paper/paper-torn-strip-small.png";
import washiTape from "@/assets/collage/paper/paper-washi-tape.png";

import doodleBear from "@/assets/collage/doodles/doodle-bear.png";
import doodleArrow from "@/assets/collage/doodles/doodle-arrow.png";
import doodleArrowLoop from "@/assets/collage/doodles/doodle-arrow-loop.png";
import doodleHeartA from "@/assets/collage/doodles/doodle-heart-a.png";
import doodleHeartB from "@/assets/collage/doodles/doodle-heart-b.png";
import doodleHeartC from "@/assets/collage/doodles/doodle-heart-c.png";
import doodleSparkleA from "@/assets/collage/doodles/doodle-sparkle-a.png";
import doodleSparkleB from "@/assets/collage/doodles/doodle-sparkle-b.png";
import doodleStar from "@/assets/collage/doodles/doodle-star.png";
import doodleUnderline from "@/assets/collage/doodles/doodle-underline.png";
import iconGithub from "@/assets/collage/doodles/doodle-icon-github.png";
import iconEmail from "@/assets/collage/doodles/doodle-icon-email.png";
import iconRss from "@/assets/collage/doodles/doodle-icon-rss.png";

interface Props {
  showSocials?: boolean;
}

const { showSocials = SOCIALS.length > 0 } = Astro.props;

const SOCIAL_STICKERS: Record<string, ImageMetadata> = {
  GitHub: iconGithub,
  Mail: iconEmail,
  Rss: iconRss,
};

const SOCIAL_ROT = ["-8deg", "5deg", "-4deg"] as const;
---

<section
  id="hero"
  class="collage-hero"
  data-collage-board
  aria-labelledby="collage-title"
>
  <h1 id="collage-title" class="collage-title" data-draggable>
    <Image
      src={cloudBanner}
      alt=""
      width={956}
      sizes="(min-width: 900px) 34rem, 94vw"
      draggable="false"
      class="collage-title__paper"
    />
    <span class="collage-title__copy">
      <span class="collage-title__doit">
        doit
        <Image
          src={doodleUnderline}
          alt=""
          width={429}
          draggable="false"
          class="collage-title__underline"
        />
      </span>
      <span class="collage-title__cjk">杜伊特</span>
    </span>
  </h1>

  <blockquote class="collage-quote" data-draggable lang="en">
    <Image
      src={tornLong}
      alt=""
      width={1443}
      sizes="(min-width: 900px) 40rem, 96vw"
      draggable="false"
      class="collage-quote__paper"
    />
    <Image
      src={washiTape}
      alt=""
      width={259}
      draggable="false"
      class="collage-quote__washi"
    />
    <p>
      “To see the world, things dangerous to come to, to see behind walls, to
      draw closer, to find each other and to feel. That is the purpose of life.”
    </p>
  </blockquote>

  <figure class="collage-bear" data-draggable>
    <Image
      src={doodleBear}
      alt="一只举手的线稿小熊贴纸"
      width={711}
      sizes="(min-width: 900px) 22rem, 78vw"
      draggable="false"
    />
  </figure>

  {
    showSocials && (
      <nav class="collage-socials" aria-label="社交链接">
        {SOCIALS.map((social, index) => {
          const sticker = SOCIAL_STICKERS[social.name];
          if (!sticker) return null;
          return (
            <CollageSticker
              class={`collage-social collage-social--${social.name.toLowerCase()}`}
              src={sticker}
              width={180}
              rot={SOCIAL_ROT[index] ?? "0deg"}
              href={social.href}
              title={social.linkTitle}
              alt=""
            >
              <span class="sr-only">{social.linkTitle}</span>
            </CollageSticker>
          );
        })}
      </nav>
    )
  }

  <CollageSticker
    class="collage-heart collage-heart--a"
    src={doodleHeartA}
    width={211}
  />
  <CollageSticker
    class="collage-heart collage-heart--b collage-desktop"
    src={doodleHeartB}
    width={240}
  />
  <CollageSticker
    class="collage-sparkle collage-sparkle--a"
    src={doodleSparkleA}
    width={201}
  />
  <CollageSticker
    class="collage-sparkle collage-sparkle--b collage-desktop"
    src={doodleSparkleB}
    width={232}
  />
  <CollageSticker
    class="collage-star collage-desktop"
    src={doodleStar}
    width={178}
  />
  <CollageSticker class="collage-arrow" src={doodleArrow} width={478} />
  <CollageSticker
    class="collage-arrow-loop collage-desktop"
    src={doodleArrowLoop}
    width={462}
  />
  <CollageSticker
    class="collage-spiral collage-desktop"
    src={spiralNotebook}
    width={804}
    sizes="14rem"
  />
  <CollageSticker
    class="collage-torn collage-torn--med collage-desktop"
    src={tornMed}
    width={471}
  />
  <CollageSticker
    class="collage-torn collage-torn--small"
    src={tornSmall}
    width={451}
  />

  <div class="collage-stamp collage-desktop" data-draggable aria-hidden="true">
    <Image src={postageStamp} alt="" width={443} draggable="false" />
    <Image
      src={doodleHeartC}
      alt=""
      width={232}
      draggable="false"
      class="collage-stamp__heart"
    />
  </div>
</section>

<CollageDrag client:only="react" />
