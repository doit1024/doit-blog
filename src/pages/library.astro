---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Main from "@/layouts/Main.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LibraryCard from "@/components/library/LibraryCard.astro";
import {
  LIBRARY_PAGE_SIZE,
  safeJson,
  toLibraryEntry,
} from "@/components/library/entries";
import { SITE } from "@/config";
import { compareMedia, MEDIA_TYPES } from "@/utils/media-library/types";
import "@/styles/library.css";

export const prerender = true;

const filters = [
  { id: "all", label: "全部" },
  ...MEDIA_TYPES.map(type => ({ id: type, label: type })),
  { id: "dropped", label: "弃坑" },
];

const items = (await getCollection("media"))
  .map(entry => ({ id: entry.id, ...entry.data }))
  .filter(item => item.title)
  .sort(compareMedia);

const catalog = items.map(toLibraryEntry);
const initial = items.filter(item => !item.dropped).slice(0, LIBRARY_PAGE_SIZE);
const hasMore = catalog.filter(item => !item.dropped).length > initial.length;
const payloadJson = safeJson({
  pageSize: LIBRARY_PAGE_SIZE,
  items: catalog,
});
---

<Layout
  title={`读看听玩 | ${SITE.title}`}
  description="书、电影、电视剧、综艺、音乐和游戏。"
>
  <Header />
  <Main
    pageTitle="读看听玩"
    pageDesc="看过、听过、在玩的东西。"
    showBreadcrumb={false}
  >
    <div class="library">
      {
        items.length > 0 && (
          <div class="library-filters" role="toolbar" aria-label="按类型筛选">
            {filters.map(filter => (
              <button
                type="button"
                data-filter={filter.id}
                aria-pressed={filter.id === "all" ? "true" : "false"}
              >
                {filter.label}
              </button>
            ))}
          </div>
        )
      }

      {
        items.length === 0 ? (
          <p class="library-empty">暂时没有条目。</p>
        ) : (
          <div data-library>
            <ul class="library-grid" data-library-grid>
              {initial.map(item => (
                <LibraryCard item={item} />
              ))}
            </ul>
            <button
              type="button"
              class="library-more"
              data-library-more
              hidden={!hasMore}
            >
              加载更多
            </button>
            <p
              class="library-empty"
              data-library-empty
              hidden={initial.length !== 0}
            >
              这个分类里还没有条目。
            </p>
            <script
              is:inline
              type="application/json"
              data-library-payload
              set:html={payloadJson}
            />
          </div>
        )
      }
    </div>
  </Main>
  <Footer />
</Layout>

<script>
  import { bootLibrary } from "@/components/library/client";

  bootLibrary();
  document.addEventListener("astro:page-load", bootLibrary);
</script>
