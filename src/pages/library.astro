---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Main from "@/layouts/Main.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LibraryCard from "@/components/library/LibraryCard.astro";
import {
  LIBRARY_PAGE_SIZE,
  safeJson,
  toLibraryEntry,
} from "@/components/library/entries";
import { SITE } from "@/config";
import {
  compareMedia,
  DEFAULT_LIBRARY_FILTER,
  LIBRARY_BROWSE_TYPES,
  mediaTypesMatch,
} from "@/utils/media-library/types";
import "@/styles/library.css";

export const prerender = true;

const filters = LIBRARY_BROWSE_TYPES.map(type => ({ id: type, label: type }));

const items = (await getCollection("media"))
  .map(entry => ({ id: entry.id, ...entry.data }))
  .filter(item => item.title)
  .sort(compareMedia);

const catalog = items.map(toLibraryEntry);
const initialPool = items.filter(item =>
  mediaTypesMatch(item.type, DEFAULT_LIBRARY_FILTER)
);
const initial = initialPool.slice(0, LIBRARY_PAGE_SIZE);
const hasMore = initialPool.length > initial.length;
const payloadJson = safeJson({
  pageSize: LIBRARY_PAGE_SIZE,
  items: catalog,
});
---

<Layout
  title={`书影音游 | ${SITE.title}`}
  description="书、电影、剧集、音乐和游戏。"
>
  <Header />
  <Main
    pageTitle="书影音游"
    pageDesc="看过、听过、在玩的东西。"
    showBreadcrumb={false}
  >
    <div class="library">
      {
        items.length > 0 && (
          <div class="library-filters" role="toolbar" aria-label="按类型筛选">
            {filters.map(filter => (
              <button
                type="button"
                data-filter={filter.id}
                aria-pressed={
                  filter.id === DEFAULT_LIBRARY_FILTER ? "true" : "false"
                }
              >
                {filter.label}
              </button>
            ))}
          </div>
        )
      }

      {
        items.length === 0 ? (
          <p class="library-empty">暂时没有条目。</p>
        ) : (
          <div data-library>
            <ul class="library-grid" data-library-grid>
              {initial.map((item, index) => (
                <LibraryCard
                  item={item}
                  eager={index < 4}
                  fetchPriority={index === 0 ? "high" : undefined}
                />
              ))}
            </ul>
            <button
              type="button"
              class="library-more"
              data-library-more
              hidden={!hasMore}
            >
              加载更多
            </button>
            <p
              class="library-empty"
              data-library-empty
              hidden={initial.length !== 0}
            >
              这个分类里还没有条目。
            </p>
            <script
              is:inline
              type="application/json"
              data-library-payload
              set:html={payloadJson}
            />
            <dialog
              class="library-dialog"
              data-library-dialog
              aria-modal="true"
              aria-labelledby="library-dialog-title"
              tabindex="-1"
            >
              <div class="library-dialog-sheet">
                <button
                  type="button"
                  class="library-dialog-close"
                  data-library-dialog-close
                >
                  关闭
                </button>
                <div class="library-dialog-layout">
                  <div
                    class="poster library-dialog-poster"
                    data-dialog-poster
                    data-poster
                  />
                  <div class="library-dialog-copy">
                    <h2 id="library-dialog-title" data-dialog-title />
                    <p class="library-dialog-meta" data-dialog-meta hidden />
                    <p class="library-dialog-hours" data-dialog-hours hidden>
                      <span class="library-dialog-hours-label">游戏时长</span>
                      <span data-dialog-hours-value />
                    </p>
                    <p class="library-dialog-artist" data-dialog-artist hidden>
                      <span class="library-dialog-artist-label">专辑艺人</span>
                      <span data-dialog-artist-value />
                    </p>
                    <p class="library-dialog-rating" data-dialog-rating hidden>
                      <span
                        class="library-dialog-stars"
                        data-dialog-stars
                        role="img"
                      >
                        <span class="library-sr" data-dialog-rating-text />
                        <span
                          class="library-dialog-stars-row"
                          data-dialog-stars-visual
                          aria-hidden="true"
                        />
                      </span>
                    </p>
                    <p class="library-dialog-note" data-dialog-note />
                    <a
                      class="library-dialog-link"
                      data-dialog-link
                      hidden
                      target="_blank"
                      rel="noopener noreferrer"
                    />
                    <p
                      class="library-dialog-created"
                      data-dialog-created
                      hidden
                    >
                      创建于
                      <time data-dialog-created-value />
                    </p>
                  </div>
                </div>
              </div>
            </dialog>
          </div>
        )
      }
    </div>
  </Main>
  <Footer />
</Layout>

<script>
  import { bootLibrary } from "@/components/library/client";

  bootLibrary();
  document.addEventListener("astro:page-load", bootLibrary);
</script>
